punctuation_method: COMMA_PERIOD
space_character_form: FUNDAMENTAL_HALF_WIDTH
use_emoji_conversion: true
character_form_rules { group: "ア" preedit_character_form: FULL_WIDTH conversion_character_form: FULL_WIDTH }
character_form_rules { group: "A" preedit_character_form: FULL_WIDTH conversion_character_form: LAST_FORM }
character_form_rules { group: "0" preedit_character_form: FULL_WIDTH conversion_character_form: LAST_FORM }
character_form_rules { group: "(){}[]" preedit_character_form: FULL_WIDTH conversion_character_form: LAST_FORM }
character_form_rules { group: ".," preedit_character_form: FULL_WIDTH conversion_character_form: LAST_FORM }
character_form_rules { group: "。、" preedit_character_form: FULL_WIDTH conversion_character_form: FULL_WIDTH }
character_form_rules { group: "・「」" preedit_character_form: FULL_WIDTH conversion_character_form: FULL_WIDTH }
character_form_rules { group: "\"'" preedit_character_form: FULL_WIDTH conversion_character_form: LAST_FORM }
character_form_rules { group: ":;" preedit_character_form: FULL_WIDTH conversion_character_form: LAST_FORM }
character_form_rules { group: "#%&@$^_|`\\" preedit_character_form: FULL_WIDTH conversion_character_form: LAST_FORM }
character_form_rules { group: "~" preedit_character_form: FULL_WIDTH conversion_character_form: LAST_FORM }
character_form_rules { group: "<>=+-/*" preedit_character_form: FULL_WIDTH conversion_character_form: LAST_FORM }
character_form_rules { group: "?!" preedit_character_form: FULL_WIDTH conversion_character_form: LAST_FORM }
